<!doctype html>
<html lang="zh-CN" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>学员端 · FDE 模拟商战</title>
  <!-- 主题须在首次绘制前定好,否则深色用户会看到白屏闪一下 -->
  <script is:inline>try{var t=localStorage.getItem('fde.theme');if(t==='dark')document.documentElement.dataset.theme='dark';}catch(e){}</script>
<style is:global>
/* ══════════ 主题 token ══════════ */
:root{ /* 浅色（默认）—— 长时间阅读优先 */
  --bg:#f7f7f5; --surf:#ffffff; --surf2:#f1f1ee;
  --ink:#34323d; --muted:#55535f; --faint:#6b6874;
  --violet:#6d28d9; --cyan:#0e7490;
  --border:rgba(20,18,30,.13); --border2:rgba(20,18,30,.075);
  --warn:#92400e; --ok:#047857; --bad:#b91c1c;
  --warn-t:rgba(180,83,9,.10); --ok-t:rgba(4,120,87,.10); --bad-t:rgba(185,28,28,.10);
  --grad:linear-gradient(92deg,#6d28d9,#0e7490);
  --track:rgba(20,18,30,.09);
  --shadow:0 1px 2px rgba(20,18,30,.04), 0 6px 20px rgba(20,18,30,.055);
  --warnface:linear-gradient(92deg,#d97706,#f59e0b);
  --badface:linear-gradient(92deg,#b91c1c,#ef4444);
  --mono:ui-monospace,"SF Mono","Cascadia Code","JetBrains Mono",Menlo,Consolas,monospace;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei","Helvetica Neue",Arial,sans-serif;
}
[data-theme="dark"]{ /* 深色（可选）—— 投影/暗场/个人偏好；对比度已下调，避免晕光 */
  --bg:#111119; --surf:#17171f; --surf2:#1d1d26;
  --ink:#d8d6e2; --muted:#a4a1b2; --faint:#8f8c9c;
  --violet:#b98cf8; --cyan:#5ad7ea;
  --border:rgba(255,255,255,.13); --border2:rgba(255,255,255,.07);
  /* ⚠️ 深色徽章降亮度：原 #fbbf24 / #34d399 / #f87171 在深底上"发光",
     抢了警告条与主按钮的注意力。降到中档仍全部 ≥4.5:1（实算见 contrast_components.py） */
  --warn:#e5a52c; --ok:#3fbf8c; --bad:#e26d6d;
  --warn-t:rgba(251,191,36,.13); --ok-t:rgba(52,211,153,.13); --bad-t:rgba(248,113,113,.13);
  --grad:linear-gradient(92deg,#b98cf8,#5ad7ea);
  --track:rgba(255,255,255,.09);
  --shadow:none;
  --warnface:linear-gradient(92deg,#d97706,#fbbf24);
  --badface:linear-gradient(92deg,#dc2626,#f87171);
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:var(--sans);background:var(--bg);color:var(--ink);line-height:1.75;
  font-size:15px;-webkit-font-smoothing:antialiased;min-height:100vh;overflow-x:hidden;
  transition:background .2s,color .2s}
.wrap{max-width:1240px;margin:0 auto;padding:0 24px}
.mono{font-family:var(--mono)}
.grad{background:var(--grad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}

/* ---------- 顶栏 ---------- */
header{position:sticky;top:0;z-index:50;background:var(--surf);border-bottom:1px solid var(--border2)}
.hbar{display:flex;align-items:center;gap:18px;height:60px}
.logo{font-weight:800;letter-spacing:-.5px;font-size:16px;white-space:nowrap}
.logo b{color:var(--cyan)}
.hsep{flex:1}
.chip{display:inline-flex;align-items:center;gap:7px;padding:5px 12px;border-radius:999px;
  border:1px solid var(--border);background:var(--surf2);font-size:12.5px;color:var(--muted);white-space:nowrap}
.chip.on{border-color:var(--cyan);color:var(--cyan)}
.dot{width:6px;height:6px;border-radius:50%;background:var(--ok)}
.dot.p{background:var(--violet)}
button.tog{font:inherit;font-size:12.5px;padding:6px 14px;border-radius:999px;cursor:pointer;
  border:1px solid var(--border);background:var(--surf2);color:var(--muted);transition:.15s}
button.tog:hover{color:var(--ink);border-color:var(--cyan)}

/* ---------- 标签导航 ---------- */
nav.tabs{display:flex;gap:6px;padding:18px 0 0;flex-wrap:wrap}
nav.tabs button{font:inherit;font-size:13.5px;padding:9px 17px;border-radius:999px;cursor:pointer;
  border:1px solid var(--border);background:var(--surf);color:var(--muted);transition:.15s}
nav.tabs button:hover{color:var(--ink)}
nav.tabs button[aria-selected="true"]{color:#fff;border-color:transparent;background:var(--grad);font-weight:600}

/* ---------- 通用 ---------- */
section.screen{display:none;padding:28px 0 90px}
section.screen[data-on="1"]{display:block}
.lbl{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--cyan);font-weight:650}
h1{font-size:33px;font-weight:800;letter-spacing:-.5px;margin:9px 0 8px;line-height:1.3}
h2{font-size:19px;font-weight:700;margin-bottom:14px;letter-spacing:-.2px}
h3{font-size:14.5px;font-weight:650;margin-bottom:8px}
p.sub{color:var(--muted);font-size:14.5px;max-width:700px;line-height:1.8}
.card{border:1px solid var(--border2);background:var(--surf);border-radius:14px;padding:22px;box-shadow:var(--shadow)}
.grid{display:grid;gap:16px}
.g3{grid-template-columns:repeat(3,1fr)}
.g13{grid-template-columns:1.55fr 1fr}
@media(max-width:900px){.g3,.g13{grid-template-columns:1fr}}
.mut{color:var(--muted);font-size:13px}
.faint{color:var(--faint);font-size:12.5px}
hr.sep{border:0;border-top:1px solid var(--border2);margin:18px 0}

/* ---------- 徽章 ---------- */
.badge{display:inline-block;padding:2.5px 9px;border-radius:6px;font-size:12px;font-weight:650}
.b-gate{background:var(--warn-t);color:var(--warn);border:1px solid var(--warn)}
.b-cont{background:var(--ok-t);color:var(--ok);border:1px solid var(--ok)}
.b-hot{background:var(--bad-t);color:var(--bad);border:1px solid var(--bad)}
.b-eng{background:transparent;color:var(--cyan);border:1px solid var(--cyan)}
.b-val{background:transparent;color:var(--violet);border:1px solid var(--violet)}
.b-no{background:var(--bad-t);color:var(--bad);border:1px solid var(--bad)}
.b-card{background:var(--surf2);color:var(--faint);border:1px solid var(--border)}

/* ---------- ③ 结构化数值项(2026-09-26) ---------- */
/* 学员只填原始参数，派生量（Δ/上限/兑现率）由平台算并显示在下方读数区 */
.fde-nums{margin-top:12px;padding:12px 14px;border-radius:11px;
  background:var(--surf2);border:1px dashed var(--border2)}
.fde-numgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px 14px}
.fde-numcell{display:flex;flex-direction:column;gap:4px}
.fde-numcap{display:flex;align-items:center;gap:7px;flex-wrap:wrap}
.fde-numlb{font-size:12.5px;color:var(--fg);font-weight:600}
.fde-numin{width:100%;padding:7px 10px;border-radius:8px;font-family:var(--mono);
  border:1px solid var(--border2);background:var(--bg);color:var(--fg);font-size:13.5px}
.fde-numin:focus{outline:none;border-color:var(--cyan)}
.fde-numro{padding:7px 10px;border-radius:8px;font-family:var(--mono);font-size:13.5px;
  background:var(--bg);border:1px solid var(--border2);color:var(--faint)}
.fde-numg{margin-top:8px}
.fde-numout{margin-top:11px;padding-top:10px;border-top:1px solid var(--border2)}
.fde-numl{font-family:var(--mono);font-size:12.5px;color:var(--faint);margin-bottom:6px}
.fde-numv{font-size:13px;line-height:1.95}
/* ⭐ ③-a EvalRun 产物登记：不是交付物，是判分证据 —— 视觉上要与 41 项区分开 */
.fde-evrun{margin-top:14px;margin-bottom:25px;padding:14px 16px;border-radius:11px;
  background:var(--surf2);border:1px dashed var(--cyan)}
.fde-evnote{font-size:12.5px;line-height:1.9;color:var(--faint);
  padding:9px 12px;border-radius:8px;background:var(--bg);
  border-left:3px solid var(--cyan);margin-bottom:12px}
.fde-evgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px 14px}
.fde-evin{width:100%;padding:7px 10px;border-radius:8px;font-family:var(--mono);
  border:1px solid var(--border2);background:var(--bg);color:var(--fg);font-size:13.5px}
.fde-evin:focus{outline:none;border-color:var(--cyan)}
.fde-evro{background:var(--surf2);color:var(--faint);cursor:not-allowed}
.fde-evout{margin-top:12px;padding-top:10px;border-top:1px solid var(--border2)}
.fde-numv b{font-family:var(--mono);font-weight:650}
.fde-numv.warn{color:var(--warn);font-size:12.5px;line-height:1.7}

/* ---------- 交付物清单 ---------- */
.dlist{display:flex;flex-direction:column;gap:9px}
.drow{display:flex;align-items:flex-start;gap:12px;padding:13px 15px;border-radius:11px;
  border:1px solid var(--border2);background:var(--surf2);transition:.15s}
.drow:hover{border-color:var(--border)}
.dnum{font-family:var(--mono);font-size:12px;color:var(--faint);padding-top:2px;min-width:18px}
.dbody{flex:1}
.dtitle{font-size:14px;font-weight:620}
/* ⚠️ .dmeta / .hint 是"学员要反复读的规则文字"，不放到最弱色阶 ——
   实测 .dmeta 用 faint 只有 4.81:1，虽过 AA 但在 5 天长时段里偏累。
   层级由字号与位置承载，不靠把规则文字调淡。 */
.dmeta{font-size:12.5px;color:var(--muted);margin-top:2px}
.dtags{display:flex;gap:6px;flex-wrap:wrap;padding-top:4px}
.tick{width:19px;height:19px;border-radius:50%;border:1.5px solid var(--border);
  display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--faint);flex:none;margin-top:2px}
.tick.done{background:var(--ok-t);border-color:var(--ok);color:var(--ok)}

/* ---------- 数据 ---------- */
.stats{display:flex;gap:26px;flex-wrap:wrap;align-items:baseline}
.stat .k{font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--faint)}
.stat .v{font-size:25px;font-weight:750;font-family:var(--mono);letter-spacing:-.5px}
.stat .v small{font-size:12.5px;color:var(--muted);font-weight:400;font-family:var(--sans)}
.kv{display:grid;grid-template-columns:auto 1fr;gap:7px 16px;font-size:13px}
.kv dt{color:var(--faint)}
.kv dd{color:var(--ink);font-family:var(--mono);font-size:12.5px}
table.t{width:100%;border-collapse:collapse;font-size:13px}
table.t th{text-align:left;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--faint);
  font-weight:650;padding:9px 10px;border-bottom:1px solid var(--border)}
table.t td{padding:11px 10px;border-bottom:1px solid var(--border2);vertical-align:top}
table.t tr:last-child td{border-bottom:0}

/* ---------- 表单 ---------- */
label.f{display:block;font-size:13px;font-weight:630;margin-bottom:6px}
.hint{font-size:12.5px;color:var(--faint);margin-bottom:10px;line-height:1.75}
input[type=text],textarea,select{width:100%;font:inherit;font-size:13.5px;padding:11px 13px;border-radius:9px;
  border:1px solid var(--border);background:var(--surf2);color:var(--ink);outline:none}
input:focus,textarea:focus,select:focus{border-color:var(--cyan);box-shadow:0 0 0 3px var(--ok-t)}
textarea{resize:vertical;min-height:84px;line-height:1.75}
.locked{position:relative}
.locked input{color:var(--muted);cursor:not-allowed;padding-right:132px}
.locksrc{position:absolute;right:11px;top:50%;transform:translateY(-50%);font-size:11px;
  font-family:var(--mono);color:var(--faint);pointer-events:none}
.fieldset{margin-bottom:25px}
.calc-note{border-left:3px solid var(--warn);padding:11px 14px;background:var(--warn-t);
  border-radius:0 9px 9px 0;font-size:12.5px;color:var(--muted);margin-top:11px;line-height:1.75}
.calc-note b{color:var(--ink)}

/* ---------- 评分 ---------- */
.score-hero{display:grid;grid-template-columns:auto 1fr;gap:32px;align-items:center}
@media(max-width:820px){.score-hero{grid-template-columns:1fr}}
.bignum{font-family:var(--mono);font-size:58px;font-weight:800;letter-spacing:-3px;line-height:1;
  background:var(--grad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.bars{display:flex;flex-direction:column;gap:13px;min-width:290px}
.bar{display:grid;grid-template-columns:80px 1fr 52px;gap:11px;align-items:center;font-size:12.5px}
.bar .track{height:8px;border-radius:99px;background:var(--track);overflow:hidden}
.bar .fill{display:block;height:100%;border-radius:99px;background:var(--grad)}
.bar .fill.warn{background:var(--warnface)}
.bar .fill.bad{background:var(--badface)}
.bar .val{font-family:var(--mono);text-align:right;color:var(--muted)}
.formula{font-family:var(--mono);font-size:12.5px;color:var(--muted);padding:11px 14px;border-radius:9px;
  background:var(--surf2);border:1px solid var(--border2);margin-top:14px;overflow-x:auto;white-space:nowrap}

/* ---------- 提示条 ---------- */
.callout{border-radius:11px;padding:14px 17px;font-size:13px;display:flex;gap:11px;align-items:flex-start;line-height:1.75}
.c-warn{background:var(--warn-t);border:1px solid var(--warn)}
.c-info{background:var(--ok-t);border:1px solid var(--ok)}
.c-bad{background:var(--bad-t);border:1px solid var(--bad)}
.callout .ic{font-size:15px;line-height:1.5}

.footnote{margin-top:28px;padding-top:18px;border-top:1px solid var(--border2);
  font-size:12px;color:var(--faint);line-height:1.9}
.footnote code{font-family:var(--mono);color:var(--muted);background:var(--surf2);
  padding:1px 5px;border-radius:4px;font-size:11.5px;border:1px solid var(--border2)}
/* ══════════ P5 方法论参考抽屉 ══════════
   ⚠️ 设计要点：必须是「抽屉」不是「跳页」——
   学员正在填表时查方法论，不能丢掉已填内容。 */
.drawer{position:fixed;inset:0;z-index:60;display:none}
.drawer.open{display:block}
.drawer .mask{position:absolute;inset:0;background:rgba(20,18,30,.45)}
.drawer .panel{position:absolute;top:0;right:0;bottom:0;width:min(700px,95vw);
  background:var(--bg);border-left:1px solid var(--border);overflow-y:auto;
  padding:22px 26px 70px;box-shadow:-18px 0 48px rgba(20,18,30,.16)}
.dhead{display:flex;align-items:center;gap:10px;position:sticky;top:-22px;
  background:var(--bg);padding:14px 0 12px;border-bottom:1px solid var(--border2);
  z-index:2;margin-bottom:8px}
.dclose{margin-left:auto;font-size:13px;padding:5px 13px;border-radius:8px;
  border:1px solid var(--border);background:var(--surf);color:var(--muted);
  cursor:pointer;font-family:inherit}
.dclose:hover{border-color:var(--violet);color:var(--violet)}
.dtabs{display:flex;gap:7px;margin:14px 0 18px;flex-wrap:wrap}
.dtab{font-size:13px;padding:6px 14px;border-radius:8px;border:1px solid var(--border);
  background:var(--surf);color:var(--muted);cursor:pointer;font-family:inherit}
.dtab.on{background:var(--violet-t);border-color:var(--violet);color:var(--violet);font-weight:650}
.stn{background:var(--surf);border:1px solid var(--border);border-radius:11px;
  padding:14px 16px;margin-bottom:10px}
.stn .sh{display:flex;align-items:baseline;gap:9px;flex-wrap:wrap}
.stn .sid{font-family:var(--mono);font-size:12.5px;font-weight:700;color:var(--violet)}
.stn .sn{font-size:14.5px;font-weight:650}
.stn dl{margin:8px 0 0;font-size:13px;line-height:1.85}
.stn dt{display:inline;font-weight:650;color:var(--ink)}
.stn dd{display:inline;margin:0 0 0 4px;color:var(--muted)}
.stn dd::after{content:"";display:block}
.tool{display:flex;gap:10px;padding:9px 11px;border-radius:8px;background:var(--surf2);
  border:1px solid var(--border2);margin-bottom:6px;font-size:13px}
.tool .fid{font-family:var(--mono);font-size:12.5px;font-weight:700;color:var(--violet);
  flex:none;min-width:56px}
.tool .ftx{flex:1;color:var(--muted)}
.tool .ftx b{color:var(--ink);font-weight:620}
/* 本回合（S1）该用的工具高亮 —— 让学员"打开就知道用哪张" */
.tool[data-s1="1"]{background:var(--violet-t);border-color:var(--violet)}
.tool[data-s1="1"]::after{content:"本回合用";font-size:11px;font-weight:650;
  color:var(--violet);align-self:center;flex:none;white-space:nowrap}
</style>
<style is:global>
a.logo{text-decoration:none;color:inherit}
a.logo:hover b{text-decoration:underline}
</style>
</head>
<body>
<header><div class="wrap hbar">
  <a class="logo" href="/">Learn<b>FDE</b> <span class="mut" style="font-weight:400">Sim</span></a>
  <span class="chip on" data-fde-round><span class="dot p"></span>回合 S1 · 挑活</span>
  <span class="chip">组 <b class="mono" id="fde-banner-team">（未设组号）</b></span>
  <span class="hsep"></span>
  <span class="chip mono" data-fde-clock-chip>—</span>
  <button class="tog" onclick="openM()">📘 方法论参考</button>
  <button class="tog" onclick="theme()">🌗 浅色 / 深色</button>
</div></header>

<div class="wrap">
<nav class="tabs" role="tablist">
  <button role="tab" aria-selected="true"  onclick="go(0,this)">① 回合工作台</button>
  <button role="tab" aria-selected="false" onclick="go(1,this)">② 客户档案</button>
  <button role="tab" aria-selected="false" onclick="go(2,this)">③ 交付物表单</button>
  <button role="tab" aria-selected="false" onclick="go(3,this)">④ 甲方质询预演</button>
  <button role="tab" aria-selected="false" onclick="go(4,this)">⑤ 评分看板</button>
</nav>

<!-- ══════════ P5 方法论参考抽屉 ══════════ -->
<div class="drawer" id="mdrawer" onclick="if(event.target===this||event.target.classList.contains('mask'))closeM()">
  <div class="mask"></div>
  <div class="panel">
    <div class="dhead">
      <span class="lbl">Methodology Reference · 方法论参考</span>
      <button class="dclose" onclick="closeM()">关闭 ✕</button>
    </div>
    <p class="sub" style="margin-top:2px">
      内容来自 <b>808 五站业务方法论 正式版 v1.0</b>（2026-09-15）与 <b>809 工具包 v1.0</b>。
      <b>不用背</b> —— 做作业时随时打开查。
    </p>

    <div class="note info" style="font-size:13px">
      <b>⏱ 当前回合：S1 挑活</b> —— 本站最小工具组合是
      <b class="mono">F00 / F01 / F02 / F09 / F03 / F07</b>（见下方「工具包」页高亮项）。
    </div>

    <div class="dtabs">
      <button class="dtab on" onclick="dt(0,this)">① 五站（S1–S5）</button>
      <button class="dtab" onclick="dt(1,this)">② 工具包（F00–F15）</button>
    </div>

    <!-- ① 五站 -->
    <div class="dsec" data-don="1">
      <div class="stn">
        <div class="sh"><span class="sid">S1</span><span class="sn">AI业务用例筛选与切片</span>
          <span class="badge b-vio">挑活</span></div>
        <dl>
          <dt>目的</dt><dd>从多条业务流程中选出<b>值得且能启动</b>的最小切片。</dd>
          <dt>入口</dt><dd>客户愿意提供候选流程；双方指定筛选联系人和授权投入。</dd>
          <dt>出站 M1</dt><dd>选择理由、边界、价值假设、负责人、运行预期及准备责任已确认；开营还须 F04 全部就绪。</dd>
        </dl>
      </div>
      <div class="stn">
        <div class="sh"><span class="sid">S2</span><span class="sn">诊断共创 PoC</span></div>
        <dl>
          <dt>目的</dt><dd>在共同工作中诊断、构建、评估<b>可运行原型</b>。</dd>
          <dt>入口</dt><dd>M1 + 客户关键人员 / 数据权限 / 环境 / 判据就绪 + 商业授权。</dd>
          <dt>出站 M2</dt><dd>原型按约定 PoC 范围验收通过，冻结 Eval v1.0 及失败记录，明确生产差距和后续承诺；<b>不授予生产权限</b>。</dd>
        </dl>
      </div>
      <div class="stn">
        <div class="sh"><span class="sid">S3</span><span class="sn">受控投产与验证</span>
          <span class="badge b-hot">M3 最终定义</span></div>
        <dl>
          <dt>目的</dt><dd>使系统在<b>限定真实业务</b>中运行并验证。</dd>
          <dt>入口</dt><dd>M2 + 生产及采纳工作范围 / 预算已授权，本站人员环境到位。</dd>
          <dt>出站 M3</dt><dd>限定真实运行<b>已发生</b>，质量、安全、运行、人工接续及阶段业务标准通过；<b>不只是获准上线</b>。</dd>
        </dl>
      </div>
      <div class="stn">
        <div class="sh"><span class="sid">S4</span><span class="sn">持续采纳与价值兑现</span></div>
        <dl>
          <dt>目的</dt><dd>形成常态使用、明确运行责任并<b>证明阶段价值</b>。</dd>
          <dt>入口</dt><dd>M3 + 稳定范围、支持安排、采纳及价值指标 / 窗口已确认。</dd>
          <dt>出站 M4</dt><dd>约定群体 / 业务任务持续使用，阶段价值和服务承接达标；<b>长期结果尚待观察的部分明确列示</b>。</dd>
        </dl>
      </div>
      <div class="stn">
        <div class="sh"><span class="sid">S5</span><span class="sn">扩张与复制</span></div>
        <dl>
          <dt>目的</dt><dd>管理一批扩张目标，验证新增价值，积累乙方能力。</dd>
          <dt>入口</dt><dd>源用例 M4；原范围稳定；扩张评估资源获准。</dd>
          <dt>出站 M5</dt><dd>本批全部必达目标完成各自必要 S3 / S4 及批次约定要求；乙方另完成资产与产品反馈处置记录。</dd>
        </dl>
      </div>

      <div class="note" style="font-size:13px">
        <b>⚠️ 三条贯通全流程的规则（808 §1）</b>
        <br>① <b>一张用例卡走五站</b>：同一张 F01 用例卡贯穿筛选、共创、运行、采纳及扩张。
        <br>② <b>三种价值</b>：增收 / 降本 / 风控，确定主价值、可选次价值及各自证据。
        <br>③ <b>三类指标分开记</b>：模型指标、使用指标、业务价值，<b>不能混为一谈</b>。
      </div>
      <div class="note bad" style="font-size:13px">
        <b>⚠️ 808 §1 的三条硬边界</b><br>
        · <b>里程碑验收 ≠ 继续投入 ≠ 生产权限 ≠ 开票 ≠ 回款</b> —— 这是五种不同状态。<br>
        · 服务按约完成但 PoC 未达标时，<b>可以按合同结算服务，却不能把 M2 写成通过</b>。<br>
        · <b>签约不等于采纳；采纳不等于收到款项。</b>
      </div>
    </div>

