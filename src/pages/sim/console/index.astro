<!-- ═══════════════════ P7 评分工作台 ═══════════════════ -->
<section id="p7" class="hide">
  <div class="lbl">Scoring Workbench · 评分工作台</div>
  <h1 data-fde-h1="&#123;S&#125; · &#123;N&#125; —— 判分">S1 · 挑活 —— 判分</h1>
