      <tr><td class="mono">T02</td><td class="mono">4</td><td class="mono">7 / 7</td><td class="mono">03:52:08</td><td><span class="badge b-cont">已判分</span></td></tr>
      <tr><td class="mono">T03</td><td class="mono">4</td><td class="mono">7 / 7</td><td class="mono">03:58:44</td><td><span class="badge b-half">待人工判分</span></td></tr>
      <tr><td class="mono">T04</td><td class="mono">4</td><td class="mono">6 / 7</td><td class="mono">—</td><td><span class="badge b-hot">未交齐</span></td></tr>
      <tr><td class="mono">T05</td><td class="mono">4</td><td class="mono">7 / 7</td><td class="mono">03:59:51</td><td><span class="badge b-half">待人工判分</span></td></tr>
