  function show(id){
    tabs.forEach(function(x){
      var s=document.getElementById(x.getAttribute('data-p'));
      if(s) s.classList.add('hide');
    });
    var t=document.getElementById(id);
    if(t) t.classList.remove('hide');
  }
  tabs.forEach(function(t){
    t.addEventListener('click',function(){
      tabs.forEach(function(x){x.classList.remove('on');});
      t.classList.add('on');
      show(t.getAttribute('data-p'));
      window.scrollTo(0,0);
    });
  });
  // 打分拨盘
  [].slice.call(document.querySelectorAll('.dial')).forEach(function(d){
    var cur=null;
    d.addEventListener('click',function(e){
      var b=e.target.closest('button'); if(!b||b.disabled) return;
      [].slice.call(d.children).forEach(function(x){x.classList.remove('on');});
      b.classList.add('on'); cur=b.textContent;
    });
  });
})();</script>

