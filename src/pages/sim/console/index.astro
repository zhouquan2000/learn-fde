<!doctype html>
<html lang="zh-CN" data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>讲师端 · FDE 模拟商战</title>
  <!-- 主题须在首次绘制前定好,否则深色用户会看到白屏闪一下 -->
  <script is:inline>try{var t=localStorage.getItem('fde.theme');if(t==='dark')document.documentElement.dataset.theme='dark';}catch(e){}</script>
<style is:global>
:root{ /* 浅色（默认）—— 长时段阅读优先 */
  --bg:#f7f7f5; --surf:#ffffff; --surf2:#f1f1ee; --surf3:#e9e9e5;
  --ink:#34323d; --muted:#55535f; --faint:#6b6874;
  --violet:#6d28d9; --cyan:#0e7490;
  --border:rgba(20,18,30,.13); --border2:rgba(20,18,30,.075);
  --warn:#92400e; --ok:#047857; --bad:#b91c1c;
  --warn-t:rgba(180,83,9,.10); --ok-t:rgba(4,120,87,.10); --bad-t:rgba(185,28,28,.10);
  --violet-t:rgba(109,40,217,.09); --cyan-t:rgba(14,116,144,.09);
  --grad:linear-gradient(92deg,#6d28d9,#0e7490);
  --track:rgba(20,18,30,.09);
  --shadow:0 1px 2px rgba(20,18,30,.05),0 8px 22px rgba(20,18,30,.045);
  --mono:ui-monospace,"SF Mono","Cascadia Code",Menlo,Consolas,monospace;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei","Helvetica Neue",Arial,sans-serif;
}
[data-theme="dark"]{
  --bg:#111119; --surf:#17171f; --surf2:#1d1d26; --surf3:#23232e;
  --ink:#d8d6e2; --muted:#a4a1b2; --faint:#8f8c9c;
  --violet:#b98cf8; --cyan:#5ad7ea;
  --border:rgba(255,255,255,.13); --border2:rgba(255,255,255,.07);
  --warn:#e5a52c; --ok:#3fbf8c; --bad:#e26d6d;
  --warn-t:rgba(251,191,36,.13); --ok-t:rgba(52,211,153,.13); --bad-t:rgba(248,113,113,.13);
  --violet-t:rgba(185,140,248,.13); --cyan-t:rgba(90,215,234,.13);
  --grad:linear-gradient(92deg,#b98cf8,#5ad7ea);
  --track:rgba(255,255,255,.09);
  --shadow:none;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);
  font-size:15px;line-height:1.75;-webkit-font-smoothing:antialiased}
code,.mono{font-family:var(--mono);font-size:.88em}
.page{max-width:1180px;margin:0 auto;padding:0 22px 64px}

/* ---------- 顶栏 ---------- */
header{display:flex;align-items:center;gap:12px;padding:16px 0;flex-wrap:wrap;
  border-bottom:1px solid var(--border2);margin-bottom:22px}
.logo{font-weight:700;font-size:16px;letter-spacing:.2px}
.logo em{font-style:normal;background:var(--grad);-webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent}
.hbadge{font-size:12.5px;padding:3px 10px;border-radius:999px;border:1px solid var(--border);
  color:var(--muted);background:var(--surf)}
.hbadge.on{color:var(--violet);border-color:var(--violet);background:var(--violet-t);font-weight:650}
.spacer{flex:1}
.tgl{font-size:12.5px;padding:4px 11px;border-radius:8px;border:1px solid var(--border);
  background:var(--surf);color:var(--muted);cursor:pointer;font-family:inherit}
.tgl:hover{border-color:var(--violet);color:var(--violet)}

/* ---------- 角色/标签页 ---------- */
.roles{display:flex;gap:8px;margin-bottom:16px}
.role{font-size:13.5px;padding:6px 16px;border-radius:9px;border:1px solid var(--border);
  background:var(--surf);color:var(--muted);cursor:pointer;font-family:inherit;font-weight:600}
.role.on{background:var(--grad);color:#fff;border-color:transparent}
.role .mono{opacity:.75;font-size:11.5px}
.tabs{display:flex;gap:8px;margin:18px 0 22px;flex-wrap:wrap}
.tab{font-size:13.5px;padding:7px 15px;border-radius:9px;border:1px solid var(--border);
  background:var(--surf);color:var(--muted);cursor:pointer;font-family:inherit}
.tab.on{background:var(--violet-t);border-color:var(--violet);color:var(--violet);font-weight:650}

.lbl{font-size:11.5px;letter-spacing:1.3px;text-transform:uppercase;color:var(--cyan);font-weight:700}
h1{font-size:24px;margin:8px 0 10px;letter-spacing:-.2px;line-height:1.35}
h2{font-size:17px;margin:30px 0 12px;letter-spacing:-.1px}
h3{font-size:14.5px;margin:20px 0 8px}
p{margin:0 0 10px;color:var(--muted)}
.sub{font-size:14.5px;color:var(--muted)}
hr.sep{border:0;border-top:1px solid var(--border2);margin:22px 0}

/* ---------- 卡片 ---------- */
.card{background:var(--surf);border:1px solid var(--border);border-radius:13px;
  padding:18px 20px;box-shadow:var(--shadow)}
.card+.card{margin-top:14px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
@media(max-width:880px){.grid2,.grid3{grid-template-columns:1fr}}

/* ---------- 徽章 ---------- */
.badge{display:inline-block;padding:2.5px 9px;border-radius:6px;font-size:12px;font-weight:650;
  line-height:1.5}
.b-gate{background:var(--warn-t);color:var(--warn);border:1px solid var(--warn)}
.b-cont{background:var(--ok-t);color:var(--ok);border:1px solid var(--ok)}
.b-hot{background:var(--bad-t);color:var(--bad);border:1px solid var(--bad)}
.b-auto{background:var(--ok-t);color:var(--ok);border:1px solid var(--ok)}
.b-man{background:var(--bad-t);color:var(--bad);border:1px solid var(--bad)}
.b-half{background:var(--warn-t);color:var(--warn);border:1px solid var(--warn)}
.b-info{background:var(--cyan-t);color:var(--cyan);border:1px solid var(--cyan)}
.b-vio{background:var(--violet-t);color:var(--violet);border:1px solid var(--violet)}
.b-ghost{background:var(--surf2);color:var(--muted);border:1px solid var(--border)}

/* ---------- 提示条 ---------- */
.note{border-left:3px solid var(--warn);background:var(--warn-t);border-radius:0 9px 9px 0;
  padding:11px 15px;font-size:13.5px;color:var(--ink);margin:14px 0}
.note.info{border-left-color:var(--cyan);background:var(--cyan-t)}
.note.bad{border-left-color:var(--bad);background:var(--bad-t)}
.note.ok{border-left-color:var(--ok);background:var(--ok-t)}

/* ---------- 打分控件 ---------- */
.row{display:flex;align-items:flex-start;gap:12px;padding:13px 14px;border-radius:10px;
  background:var(--surf2);border:1px solid var(--border2);margin-bottom:9px}
.row.auto{background:var(--surf3);border-style:dashed}
.rbody{flex:1;min-width:0}
.rtitle{font-size:14px;font-weight:620;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.rmeta{font-size:12.5px;color:var(--muted);margin-top:3px}
.rctl{flex:none;display:flex;align-items:center;gap:7px}

.dial{display:flex;gap:3px}
.dial button{width:30px;height:30px;border-radius:7px;border:1px solid var(--border);
  background:var(--surf);color:var(--muted);cursor:pointer;font-family:var(--mono);
  font-size:12.5px;font-weight:650;padding:0}
.dial button:hover{border-color:var(--violet);color:var(--violet)}
.dial button.on{background:var(--violet);border-color:var(--violet);color:#fff}
.dial button.zero{background:var(--bad-t);border-color:var(--bad);color:var(--bad)}
.dial button.zero.on{background:var(--bad);color:#fff}

.chk{display:inline-flex;align-items:center;gap:8px;font-size:13.5px;color:var(--ink);cursor:pointer}
.chk input{width:17px;height:17px;accent-color:var(--violet)}

/* ---------- 组列表 ---------- */
.glist{display:flex;flex-direction:column;gap:7px}
.gitem{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:9px;
  border:1px solid var(--border2);background:var(--surf);cursor:pointer;font-size:13.5px}
.gitem:hover{border-color:var(--violet)}
.gitem.on{border-color:var(--violet);background:var(--violet-t);font-weight:650}
.gname{flex:1}
.gitem .mono{font-size:12px;color:var(--muted)}

/* ---------- 汇总 ---------- */
.calc{font-family:var(--mono);font-size:13px;background:var(--surf2);border:1px solid var(--border2);
  border-radius:10px;padding:14px 16px;line-height:2}
.calc .k{color:var(--muted)}
.calc .v{color:var(--ink);font-weight:650}
.calc .big{font-size:21px;color:var(--violet);font-weight:700}
.bar{height:9px;border-radius:999px;background:var(--track);overflow:hidden;margin-top:7px}
.bar .fill{display:block;height:100%;border-radius:999px;background:var(--grad)}
.bar .fill.warn{background:var(--warn)}
.bar .fill.bad{background:var(--bad)}

/* ---------- 表格 ---------- */
table{width:100%;border-collapse:collapse;font-size:13.5px;margin:10px 0}
th{text-align:left;font-size:12px;letter-spacing:.5px;text-transform:uppercase;color:var(--faint);
  font-weight:700;padding:8px 10px;border-bottom:1px solid var(--border)}
td{padding:9px 10px;border-bottom:1px solid var(--border2);vertical-align:top}
td.mono,th.mono{font-family:var(--mono);font-size:12.5px}

/* ---------- 占位/待建块 ---------- */
.pending{border:1px dashed var(--border);border-radius:11px;padding:16px 18px;background:var(--surf2)}
.pending .ptitle{font-size:14px;font-weight:650;display:flex;align-items:center;gap:9px;flex-wrap:wrap}
.footnote{margin-top:34px;padding-top:16px;border-top:1px solid var(--border2);font-size:12.5px;
  color:var(--faint);line-height:2}
.footnote code{background:var(--surf2);padding:1.5px 6px;border-radius:5px;color:var(--muted)}
.hide{display:none!important}
</style>
<style is:global>
a.logo{text-decoration:none;color:inherit}
a.logo:hover b{text-decoration:underline}
</style>
</head>
